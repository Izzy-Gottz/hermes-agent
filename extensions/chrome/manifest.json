{
  "manifest_version": 3,
  "name": "Memoe — Moe in your Chrome",
  "short_name": "Memoe",
  "version": "0.2.1",
  "description": "Lets Moe, your Memoe assistant, work in a tab group of its own in your Chrome — never in your tabs.",
  "minimum_chrome_version": "125",
  "key": "",
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["debugger", "tabGroups", "nativeMessaging", "storage"],
  "action": { "default_title": "Moe works in the Moe tab group" }
}
